# Django Application Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,api,proxy
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Host Reverse Proxy Port (Section 5.8: port 8080)
HOST_PORT=8080

# Database Configuration (PostgreSQL 16)
DB_NAME=nrpj740_dev
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_USER=postgres
DB_SUPERUSER_PASSWORD=change-me-postgres-master-secret

# Database Roles (ADR-04 / Section 5.8)
# Owner credentials used for running migrations and DDL
DB_OWNER_USER=nrpj_owner
DB_OWNER_PASSWORD=change-me-owner-secret

# Application credentials used for runtime application queries (restricted)
DB_APP_USER=nrpj_app
DB_APP_PASSWORD=change-me-app-secret

# Active DB Role for Django (owner for migrate, app for runserver)
DB_USER=nrpj_owner
DB_PASSWORD=change-me-owner-secret

# Longest one SQL statement may run, in milliseconds (Section 5.7)
DB_STATEMENT_TIMEOUT_MS=30000

# Session & Cookie Security (ADR-03 / NFR-02)
SESSION_COOKIE_AGE=28800

# Seed / Evaluation Profile Settings (Section 8)
SEED_DEMO_DATA=true
DEMO_PASSWORD=change-me-demo-password

